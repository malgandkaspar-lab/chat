# Paigaldatavad paketid: taastuvad käsuga `npm install`
node_modules/

# Allalaaditud lehtede koopiad ja failid: `node ingest.js` laeb need ise uuesti alla.
# Valmis otsinguindeksid (data/index.json, data/vectors.bin ja data/cloud/) on repos,
# et vestlus töötaks kohe pärast kloonimist ja Vercelis.
data/cache/
data/files/
data/**/*.tmp

# Kohalikud seaded ja võtmed (nt AI_GATEWAY_API_KEY). Ei tohi kunagi reposse sattuda.
.env
.env.*
.vercel
